# Template for BOTH .env and .env.local
# ---------------------------------------------------
# .env       → used in production / web deployment
# .env.local → used for local development (overrides .env)
# ---------------------------------------------------
# NEVER commit .env or .env.local to git

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# LLM model to use
LLM_MODEL=gpt-4o-mini

# Qdrant Cloud — get these from https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Two separate collections — do not mix these
QDRANT_REFERENCE_COLLECTION=reference_guidelines
QDRANT_USER_COLLECTION=user_reports

# Redis — for chat checkpointing (conversation persistence)
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_TTL_DAYS=7

# Tavily — web search when reference docs lack detail (get key at https://tavily.com)
TAVILY_API_KEY=tvly-...

# Cohere — optional reranking for higher-precision retrieval (get key at https://cohere.com)
# When set, adds search_red_flag_guidelines_advanced and search_inspection_report_advanced tools
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# LangSmith — debugging, tracing, and monitoring (get key at https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=ai-realtor-inspection
